{
  "name": "planpulse-staging",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "keep_vars": true,
  "preview_urls": false,
  "assets": {
    "directory": ".staging-assets",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "vars": {
    "APP_ORIGIN": "https://planpulse-staging.delicate-cake-27e2.workers.dev",
    "STRIPE_LIVE_MODE": "false"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "planpulse-staging",
      "database_id": "33ad3356-592d-40ea-91e4-153b7184cf0e",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  }
}
